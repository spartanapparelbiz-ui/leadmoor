# ─────────────────────────────────────────────────────────────────────────────
# LeadMoor configuration
#
# Every value here is read server-side only. Nothing in this file is exposed to
# the browser: there is no NEXT_PUBLIC_ variable in the product, and the module
# that reads these is marked `server-only` so importing it from a client
# component is a build error rather than a leak.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# postgres://…  uses PostgreSQL.
# Unset        uses embedded PGlite at ./.leadmoor/pgdata — real Postgres, zero setup.
DATABASE_URL=postgres://leadmoor:leadmoor@127.0.0.1:5432/leadmoor

# Where content-addressed evidence snapshots are written.
EVIDENCE_DIR=.leadmoor/evidence

# ── Language model (optional) ───────────────────────────────────────────────
# Without this, LeadMoor still runs: requests are structured by keyword matching
# and criteria needing judgement are reported as unknown rather than guessed.
# With it, requests are compiled by Claude and fuzzy criteria are judged against
# stored evidence with mandatory citations.
# ANTHROPIC_API_KEY=

# ── Search providers (optional, Tier C) ─────────────────────────────────────
# Web-search discovery reports "provider not configured" until one is set.
# Registry and first-party discovery work without either.
# BRAVE_SEARCH_API_KEY=
# EXA_API_KEY=

# ── GitHub (optional) ───────────────────────────────────────────────────────
# The public GitHub API works unauthenticated at a lower rate limit. An ordinary
# token raises it. No scopes are required.
# GITHUB_TOKEN=

# ── Email enrichment ────────────────────────────────────────────────────────
# Default finds addresses a company published on its own site and reports them
# as unverified. Set to `none` to report every address as unavailable.
# LeadMoor never constructs an address from a name pattern under any setting.
# EMAIL_ENRICHMENT_PROVIDER=none

# ── Runtime ─────────────────────────────────────────────────────────────────
# Run the durable queue inside the web process instead of a separate worker.
# Convenient for a single-node install; use a dedicated worker in production.
LEADMOOR_EMBEDDED_WORKER=1

# debug | info | warn | error
LOG_LEVEL=info

# Idle poll interval for the dedicated worker.
# WORKER_POLL_MS=1500
