{
  "name": "leadmoor",
  "private": true,
  "version": "0.1.0",
  "description": "LeadMoor — standalone evidence-first AI lead generation. No MOOR code, data, or runtime.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm --filter @leadmoor/web dev",
    "worker": "pnpm --filter @leadmoor/worker dev",
    "build": "pnpm --filter @leadmoor/web build",
    "start": "pnpm --filter @leadmoor/web start",
    "db:push": "pnpm --filter @leadmoor/db push",
    "db:seed": "pnpm --filter @leadmoor/db seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false && tsc -p apps/web/tsconfig.json --noEmit --pretty false",
    "check:no-moor": "node scripts/check-no-moor.mjs",
    "verify": "pnpm check:no-moor && pnpm typecheck && pnpm test && pnpm build",
    "demo:seed": "tsx --tsconfig tsconfig.base.json scripts/demo.ts",
    "acceptance": "tsx --tsconfig tsconfig.base.json scripts/acceptance.ts",
    "e2e": "node scripts/e2e.mjs"
  },
  "devDependencies": {
    "@leadmoor/claims": "workspace:*",
    "@leadmoor/connectors": "workspace:*",
    "@leadmoor/core": "workspace:*",
    "@leadmoor/db": "workspace:*",
    "@leadmoor/evidence": "workspace:*",
    "@leadmoor/export": "workspace:*",
    "@leadmoor/llm": "workspace:*",
    "@leadmoor/policy": "workspace:*",
    "@leadmoor/resolution": "workspace:*",
    "@leadmoor/runtime": "workspace:*",
    "@leadmoor/scoring": "workspace:*",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "drizzle-orm": "^0.38.3",
    "playwright": "^1.62.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "zod": "^3.24.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "type": "module"
}
