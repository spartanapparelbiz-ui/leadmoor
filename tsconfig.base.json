{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "allowJs": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@leadmoor/auth": ["packages/auth/src/index.ts"],
      "@leadmoor/claims": ["packages/claims/src/index.ts"],
      "@leadmoor/claims/*": ["packages/claims/src/*"],
      "@leadmoor/core": ["packages/core/src/index.ts"],
      "@leadmoor/core/*": ["packages/core/src/*"],
      "@leadmoor/db": ["packages/db/src/index.ts"],
      "@leadmoor/db/*": ["packages/db/src/*"],
      "@leadmoor/policy": ["packages/policy/src/index.ts"],
      "@leadmoor/policy/*": ["packages/policy/src/*"],
      "@leadmoor/evidence": ["packages/evidence/src/index.ts"],
      "@leadmoor/evidence/*": ["packages/evidence/src/*"],
      "@leadmoor/connectors": ["packages/connectors/src/index.ts"],
      "@leadmoor/connectors/*": ["packages/connectors/src/*"],
      "@leadmoor/resolution": ["packages/resolution/src/index.ts"],
      "@leadmoor/resolution/*": ["packages/resolution/src/*"],
      "@leadmoor/scoring": ["packages/scoring/src/index.ts"],
      "@leadmoor/scoring/*": ["packages/scoring/src/*"],
      "@leadmoor/llm": ["packages/llm/src/index.ts"],
      "@leadmoor/llm/*": ["packages/llm/src/*"],
      "@leadmoor/runtime": ["packages/runtime/src/index.ts"],
      "@leadmoor/runtime/*": ["packages/runtime/src/*"],
      "@leadmoor/export": ["packages/export/src/index.ts"],
      "@leadmoor/export/*": ["packages/export/src/*"]
    }
  }
}
